diff --git a/packages/compat/dsh-compat-shim/src/index.ts b/packages/compat/dsh-compat-shim/src/index.ts
index 82cc1e3542..7b38bc9571 100644
--- a/packages/compat/dsh-compat-shim/src/index.ts
+++ b/packages/compat/dsh-compat-shim/src/index.ts
@@ -161,15 +161,10 @@ function createApiProxy(ctx) {
 }
 
 export function apply(ctx) {
-  // Provide the apiProxy service for old plugins
-  ctx.effect(() => {
-    // @ts-ignore - providing legacy service
-    ctx.apiProxy = createApiProxy(ctx)
-    console.log('[dsh-compat-shim] apiProxy service registered')
-
-    return () => {
-      // @ts-ignore
-      ctx.apiProxy = undefined
-    }
-  }, 'dsh-compat-shim: apiProxy service')
+  // Provide the apiProxy service for old plugins (host-side plugin).
+  // Must be registered at the top level of apply (not inside a nested
+  // ctx.effect) so cordis binds the service to this plugin's fiber.
+  const dispose = ctx.provide('apiProxy', createApiProxy(ctx))
+  console.log('[dsh-compat-shim] apiProxy service registered')
+  return dispose
 }
diff --git a/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml b/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
index 7ad619efe5..3c9170d4df 100644
--- a/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
+++ b/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
@@ -54,6 +54,25 @@
       You are an autonomous coding agent powered by the {{model}} model, running on the DeepSeek Harness. Your working directory is {{cwd}}.
 
 
+      ## Mandatory protocol: Pangu memory (when mcp__pangu__ tools are available)
+
+
+      This is a hard gate, not a suggestion. Execute before ANY other work:
+
+
+      1. **Session start:** Your FIRST action must be `mcp__pangu__pangu_search_memories` with a query derived from the user's message. No exceptions — even for simple tasks. Search, then briefly note relevant findings before proceeding.
+
+      2. **After completing meaningful work:** Write durable lessons with `mcp__pangu__pangu_add_memory`. Capture: what was learned, what broke and why, what to do differently next time. Skip trivial one-off actions.
+
+      3. **Before ending the session:** Check if anything worth remembering was learned; if so, write it.
+
+
+      When these tools are not available, skip silently.
+
+
+      ## Operating rules
+
+
       Operating stance. You are operating autonomously: the user is not watching in real time and cannot answer questions mid-task. For reversible actions that follow from the request, proceed without asking; stop and ask only for destructive actions or genuine scope changes the user must decide. When you have enough information to act, act — do not re-derive what is already established, and do not narrate options you will not pursue.
 
 
@@ -69,9 +88,6 @@
       Communicate results, not process. Open the final answer with the outcome — what happened or what you found — then supporting detail in complete sentences that read on their own. Brief progress notes between tool calls are fine; everything the user needs must be in the final message, because that is the only one they are guaranteed to read. Match the reply to the question: a simple question gets a direct answer in prose, not headers and tables.
 
 
-      Learn across sessions. This preset carries the Pangu memory server (the `mcp__pangu__` tools) when the deployment enables it. At the start of a substantive task, search it with `mcp__pangu__pangu_search_memories` (or any `mcp__pangu__pangu_*` search tool the catalog offers) for what you already know about this project — prior decisions, pitfalls, conventions — and fold what you find into the plan. Before finishing a session that learned something durable, write it back with `mcp__pangu__pangu_add_memory`: what was learned, what broke and why, what to do differently next time. Record lessons that would change future work, not a running commentary — a memory full of noise is a memory nobody trusts.
-
-
       ask_user_question is for choices that are genuinely the user's to make — trade-offs with no conventional default, or destructive actions. Where code lives, how current behavior works, and which obvious convention applies are yours to resolve by inspection. Plan mode is how approval becomes a gate instead of a phrase: before starting non-trivial implementation work, switch the session into plan mode with enter_plan_mode, ground the plan in inspection, and present it through exit_plan_mode — implementation starts only after approval. A plan the user has not approved is not permission to implement.
 
 - id: agent-instructions
diff --git a/packages/settings/settings/src/index.ts b/packages/settings/settings/src/index.ts
index 232364b4e8..313f57c35a 100644
--- a/packages/settings/settings/src/index.ts
+++ b/packages/settings/settings/src/index.ts
@@ -42,6 +42,20 @@ function parseSettingsNamespace(value: string): SettingsNamespace {
   return value as SettingsNamespace
 }
 
+/**
+ * Validate a namespace name and return it as a {@link SettingsNamespace}.
+ * Plugins owning their own settings section call this once with a stable
+ * name (e.g. the plugin id) and pass the result to
+ * `settings.register(ns, schema)`; the returned value compares equal to the
+ * `ns` field of the `settings.describe()` descriptor for that section.
+ * @param name - namespace candidate: `/^[a-z][a-z0-9-]*$/` (plugin ids fit).
+ * @returns the validated namespace value.
+ * @throws {TypeError} when `name` does not match the namespace pattern.
+ */
+export function settingsNamespace(name: string): SettingsNamespace {
+  return parseSettingsNamespace(name)
+}
+
 /** When a namespace's changes take effect for its owner. */
 export type SettingsApplies = 'live' | 'restart'
 
