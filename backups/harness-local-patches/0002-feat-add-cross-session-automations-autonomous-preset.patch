@@ -0,0 +1,161 @@
+/**
+ * Pure automation domain: input validation, due-time arithmetic, and the
+ * framing text the spawned session receives. No IO and no clock access —
+ * every function takes `now` explicitly, so the driver's decisions are
+ * testable against fake timers.
+ * @module @deepseek-ai/dsh-automations/domain
+ */
+
+import { Buffer } from 'node:buffer'
+import { randomUUID } from 'node:crypto'
+import type { AutomationId, AutomationRecord, AutomationSchedule, AutomationView } from './types.ts'
+
+/** Rejected creation input, with the reason the model can correct. */
+export class AutomationInputError extends Error {}
+
+/** Allocate one opaque automation id. */
+export function allocateAutomationId(): AutomationId {
+  return randomUUID() as AutomationId
+}
+
+/** Upper bound for a title, kept so list output stays a picker row, not a transcript. */
+export const MAX_TITLE_BYTES = 256
+
+/** Validate and normalize one creation request against the deployment limits. */
+export function validateAutomationInput(input: {
+  title: unknown
+  prompt: unknown
+  schedule: unknown
+  maxRuns: unknown
+}, limits: { maxPromptBytes: number; minDelaySeconds: number; minIntervalSeconds: number }): {
+  title: string
+  prompt: string
+  schedule: AutomationSchedule
+  maxRuns: number | undefined
+} {
+  const title = requireText(input.title, 'title')
+  if (Buffer.byteLength(title, 'utf8') > MAX_TITLE_BYTES) {
+    throw new AutomationInputError(`title exceeds ${String(MAX_TITLE_BYTES)} bytes`)
+  }
+  const prompt = requireText(input.prompt, 'prompt')
+  if (Buffer.byteLength(prompt, 'utf8') > limits.maxPromptBytes) {
+    throw new AutomationInputError(`prompt exceeds the configured maximum of ${String(limits.maxPromptBytes)} bytes`)
+  }
+  const schedule = validateSchedule(input.schedule, limits)
+  const maxRuns = validateMaxRuns(input.maxRuns, schedule)
+  return { title, prompt, schedule, maxRuns }
+}
+
+function requireText(value: unknown, field: string): string {
+  if (typeof value !== 'string' || value.trim() === '') {
+    throw new AutomationInputError(`${field} must be a non-empty string`)
+  }
+  return value
+}
+
+function validateSchedule(value: unknown, limits: {
+  minDelaySeconds: number
+  minIntervalSeconds: number
+}): AutomationSchedule {
+  if (typeof value !== 'object' || value === null) {
+    throw new AutomationInputError('schedule must be an object with a `kind`')
+  }
+  const { kind } = value as { kind?: unknown }
+  if (kind === 'after') {
+    const { delaySeconds } = value as { delaySeconds?: unknown }
+    if (typeof delaySeconds !== 'number' || !Number.isSafeInteger(delaySeconds)
+      || delaySeconds < limits.minDelaySeconds) {
+      throw new AutomationInputError(
+        `after requires an integral delaySeconds of at least ${String(limits.minDelaySeconds)}`,
+      )
+    }
+    return { kind: 'after', delaySeconds }
+  }
+  if (kind === 'at') {
+    const { at } = value as { at?: unknown }
+    if (typeof at !== 'string' || !Number.isFinite(Date.parse(at))) {
+      throw new AutomationInputError('at requires an ISO-8601 `at` timestamp')
+    }
+    return { kind: 'at', at: new Date(Date.parse(at)).toISOString() }
+  }
+  if (kind === 'every') {
+    const { intervalSeconds } = value as { intervalSeconds?: unknown }
+    if (typeof intervalSeconds !== 'number' || !Number.isSafeInteger(intervalSeconds)
+      || intervalSeconds < limits.minIntervalSeconds) {
+      throw new AutomationInputError(
+        `every requires an integral intervalSeconds of at least ${String(limits.minIntervalSeconds)}`,
+      )
+    }
+    return { kind: 'every', intervalSeconds }
+  }
+  throw new AutomationInputError('schedule.kind must be one of "after", "at", or "every"')
+}
+
+function validateMaxRuns(value: unknown, schedule: AutomationSchedule): number | undefined {
+  if (value === undefined) return undefined
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 1) {
+    throw new AutomationInputError('maxRuns must be a positive integer when present')
+  }
+  if (schedule.kind !== 'every') {
+    throw new AutomationInputError('maxRuns applies only to recurring ("every") automations')
+  }
+  return value
+}
+
+/** The first due time of one validated schedule, ISO-encoded. */
+export function resolveDueAt(schedule: AutomationSchedule, now: number): string {
+  if (schedule.kind === 'after') return new Date(now + schedule.delaySeconds * 1000).toISOString()
+  if (schedule.kind === 'at') return schedule.at
+  return new Date(now + schedule.intervalSeconds * 1000).toISOString()
+}
+
+/**
+ * The next fixed-rate occurrence strictly after `now`, anchored on the
+ * recorded due time. Occurrences that passed while the process was down
+ * coalesce: the answer is the first anchor multiple past `now`, never a
+ * burst of catch-up fires.
+ */
+export function nextRecurringAt(dueAt: string, intervalSeconds: number, now: number): string {
+  const intervalMs = intervalSeconds * 1000
+  const anchor = Date.parse(dueAt)
+  const elapsed = now - anchor
+  const skipped = elapsed > 0 ? Math.floor(elapsed / intervalMs) + 1 : 1
+  return new Date(anchor + skipped * intervalMs).toISOString()
+}
+
+/** Whether one record is due at `now` and may fire (a failed one-shot never re-fires). */
+export function isDue(record: AutomationRecord, now: number): boolean {
+  if (record.lastError !== undefined && record.schedule.kind !== 'every') return false
+  if (record.maxRuns !== undefined && record.fireCount >= record.maxRuns) return false
+  return Date.parse(record.scheduledAt) <= now
+}
+
+/** Whether one record has exhausted its fire ceiling. */
+export function isExhausted(record: AutomationRecord): boolean {
+  return record.maxRuns !== undefined && record.fireCount >= record.maxRuns
+}
+
+/** The model-facing projection of one record, with absent fields omitted. */
+export function viewOf(record: AutomationRecord): AutomationView {
+  return {
+    id: record.id,
+    title: record.title,
+    schedule: record.schedule,
+    nextRunAt: record.scheduledAt,
+    fireCount: record.fireCount,
+    ...(record.maxRuns === undefined ? {} : { maxRuns: record.maxRuns }),
+    ...(record.lastFiredAt === undefined ? {} : { lastFiredAt: record.lastFiredAt }),
+    ...(record.lastError === undefined ? {} : { lastError: record.lastError }),
+  }
+}
+
+/**
+ * The user-role framing that precedes the stored prompt in the spawned
+ * session: it names the automation so the model knows the work was scheduled,
+ * not conversational, and should be carried to completion and reported.
+ */
+export function renderAutomationFraming(record: AutomationRecord, occurrence: number): string {
+  return `This task was dispatched by the scheduled automation "${record.title}" `
+    + `(occurrence ${String(occurrence)}, scheduled ${record.scheduledAt}). `
+    + 'Work it autonomously to completion, then report the outcome.'
+}
