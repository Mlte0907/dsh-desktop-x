--- /dev/null
+++ b/packages/schedule/automations/src/spec.ts
@@ -0,0 +1,47 @@
+/**
+ * Durable storage-domain declaration for cross-session automations. One flat
+ * table keyed by automation id; the record schema is the durable boundary, so
+ * unknown fields and malformed shapes reject at open instead of reaching the
+ * driver.
+ * @module @deepseek-ai/dsh-automations/spec
+ */
+
+import { z } from 'zod'
+import { defineDomain, domainTable } from '@deepseek-ai/dsh-storage-domain'
+import type { AutomationRecord, AutomationSchedule } from './types.ts'
+
+const isoTimestamp = z.string().refine(value => Number.isFinite(Date.parse(value)), {
+  message: 'must be an ISO-8601 timestamp',
+})
+
+/** Runtime schema for one persisted schedule. */
+export const automationScheduleSchema = z.union([
+  z.object({ kind: z.literal('after'), delaySeconds: z.number().int().positive() }),
+  z.object({ kind: z.literal('at'), at: isoTimestamp }),
+  z.object({ kind: z.literal('every'), intervalSeconds: z.number().int().positive() }),
+]) satisfies z.ZodType<AutomationSchedule>
+
+/** Runtime schema for one persisted automation record. */
+export const automationRecordSchema = z.object({
+  id: z.string().min(1),
+  title: z.string().min(1),
+  prompt: z.string().min(1),
+  schedule: automationScheduleSchema,
+  cwd: z.string().min(1),
+  agentPreset: z.string().min(1).optional(),
+  createdAt: z.number().int().nonnegative(),
+  scheduledAt: isoTimestamp,
+  lastFiredAt: isoTimestamp.optional(),
+  fireCount: z.number().int().nonnegative(),
+  maxRuns: z.number().int().positive().optional(),
+  lastError: z.string().min(1).optional(),
+}) as unknown as z.ZodType<AutomationRecord>
+
+/** One flat automation table keyed by opaque id. */
+export const automationsDomainSpec = defineDomain({
+  name: 'automations',
+  version: 0,
+  tables: {
+    automations: domainTable<string, AutomationRecord>(automationRecordSchema),
+  },
+})
