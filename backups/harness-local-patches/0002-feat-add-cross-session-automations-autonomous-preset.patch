@@ -0,0 +1,23 @@
+/** Package-owned invariant companion for the plan-mode entry tool. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-tool-plan-mode'
+
+/** Cordis companion plugin name. */
+export const name = 'tool-plan-mode-invariant'
+/** Invariant registry dependency. */
+export const inject = ['invariants']
+
+/**
+ * No runtime invariant: the tool owns no durable relationship. Plan state and
+ * its `plan/mode` event vocabulary belong to `@deepseek-ai/dsh-plan-mode`,
+ * whose companion validates them; this package only forwards the model's
+ * intent to that controller.
+ */
+const install: InvariantInstaller = () => {}
+
+/** Register this package's invariant ownership. */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
diff --git a/packages/plan/tool-plan-mode/tests/tool-plan-mode.spec.ts b/packages/plan/tool-plan-mode/tests/tool-plan-mode.spec.ts
new file mode 100644
index 0000000000..456518efdc
--- /dev/null
+++ b/packages/plan/tool-plan-mode/tests/tool-plan-mode.spec.ts
@@ -0,0 +1,129 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { Session, SessionId, type UserMessage } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import PlanModeController, { foldPlanMode } from '@deepseek-ai/dsh-plan-mode'
+import * as ToolPlanMode from '../src/index.ts'
+
+const { ENTER_PLAN_MODE } = ToolPlanMode
+
+/**
+ * Drives the REAL entry tool against the REAL plan-mode controller: mounts
+ * `dsh-tool-plan-mode` beside `dsh-plan-mode`, real `ToolRuntime` and
+ * `SystemPrompt`, with fake Agents carrying real `Session`s — the same shape
+ * the plan-mode suite uses. Executions go through the registry's own execute
+ * path, so outcomes, rendered text, and the session log are the plugin's
+ * actual contract.
+ */
+
+async function setup(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(PlanModeController, { section: 'Test plan mode instructions.' })
+  await ctx.plugin(ToolPlanMode)
+  return ctx
+}
+
+async function agentWithSession(ctx: Context, id = 'agent-1'): Promise<Agent> {
+  const session = Session.create(SessionId(id))
+  const agent = {
+    id: SessionId(id),
+    session,
+    inject(message: UserMessage) {
+      session.append('user/message', message, { surfaceOp: 'append' })
+    },
+  } as unknown as Agent
+  ctx.emit('agent/created', { agent })
+  return agent
+}
+
+/** Pre-generated call ids: one test needs at most six unique tool calls. */
+const CALL_IDS = [
+  ToolCallId('call-1'), ToolCallId('call-2'), ToolCallId('call-3'),
+  ToolCallId('call-4'), ToolCallId('call-5'), ToolCallId('call-6'),
+]
+let callCounter = 0
+
+/** One registry request for the entry tool, with the next pre-generated id. */
+function enterRequest(agent?: Agent) {
+  const callId = CALL_IDS[callCounter] ?? CALL_IDS[CALL_IDS.length - 1]!
+  callCounter += 1
+  return {
+    callId,
+    name: ENTER_PLAN_MODE,
+    arguments: {},
+    signal: new AbortController().signal,
+    ...agent ? { agent } : {},
+  }
+}
+
+function resultText(result: { content: readonly { type: string; text?: string }[] }): string {
+  return result.content.map(block => block.text ?? '').join('\n')
+}
+
+describe('enter_plan_mode', () => {
+  it('registers beside exit_plan_mode with an empty parameter schema', async () => {
+    const ctx = await setup()
+    const names = ctx.tools.schemas().map(tool => tool.name)
+    expect(names).toContain(ENTER_PLAN_MODE)
+    const definition = ctx.tools.get(ENTER_PLAN_MODE)!
+    expect(definition.parameters).toEqual({ type: 'object', properties: {} })
+  })
+
+  it('commits the switch between turns and reports it as immediate', async () => {
+    const ctx = await setup()
+    const agent = await agentWithSession(ctx)
+
+    const result = await ctx.tools.execute(enterRequest(agent))
+    expect(result.isError).toBe(false)
+    expect(resultText(result)).toContain('Plan mode on')
+    expect(foldPlanMode(agent.session.events)).toBe(true)
+  })
+
+  it('queues the switch inside an open turn until the next pre-step', async () => {
+    const ctx = await setup()
+    const agent = await agentWithSession(ctx)
+    agent.session.append('turn/start', { turn: 0 })
+
+    const result = await ctx.tools.execute(enterRequest(agent))
+    expect(result.isError).toBe(false)
+    expect(resultText(result)).toContain('Entering plan mode from your next step')
+    expect(foldPlanMode(agent.session.events)).toBe(false)
+    expect(agent.session.events.some(event => event.type === 'plan/mode')).toBe(false)
+  })
+
+  it('rejects while plan mode is already active', async () => {
+    const ctx = await setup()
+    const agent = await agentWithSession(ctx)
+    agent.session.append('plan/mode', { active: true })
+
+    const result = await ctx.tools.execute(enterRequest(agent))
+    expect(result.isError).toBe(true)
+    expect(resultText(result)).toContain('only available outside plan mode')
+  })
+
+  it('stays idempotent while an entry selection is already queued', async () => {
+    const ctx = await setup()
+    const agent = await agentWithSession(ctx)
+    agent.session.append('turn/start', { turn: 0 })
+
+    const first = await ctx.tools.execute(enterRequest(agent))
+    const second = await ctx.tools.execute(enterRequest(agent))
+    expect(first.isError).toBe(false)
+    expect(second.isError).toBe(false)
+    expect(resultText(second)).toContain('Entering plan mode from your next step')
+    expect(agent.session.events.filter(event => event.type === 'turn/start')).toHaveLength(1)
+  })
+
+  it('requires a calling agent', async () => {
+    const ctx = await setup()
+
+    const result = await ctx.tools.execute(enterRequest())
+    expect(result.isError).toBe(true)
+    expect(resultText(result)).toContain('requires a calling agent')
+  })
+})
