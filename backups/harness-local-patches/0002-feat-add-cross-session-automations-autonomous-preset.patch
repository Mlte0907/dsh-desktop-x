+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context, Service } from '@deepseek-ai/cordis'
+import type { Agent, AgentHandle } from '@deepseek-ai/dsh-agent'
+import { ToolCallId, type UserMessage } from '@deepseek-ai/dsh-llm'
+import { Session, SESSION_FORMAT_VERSION, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import Storage from '@deepseek-ai/dsh-storage'
+import * as StorageDomain from '@deepseek-ai/dsh-storage-domain'
+import * as StorageJson from '@deepseek-ai/dsh-storage-json'
+import AutomationsService, { spawnAutomationSession } from '../src/index.ts'
+import { isDue, nextRecurringAt, renderAutomationFraming, resolveDueAt, validateAutomationInput } from '../src/domain.ts'
+import type { AutomationRecord } from '../src/types.ts'
+
+const LIMITS = { maxPromptBytes: 1024, minDelaySeconds: 60, minIntervalSeconds: 60 }
+
+beforeEach(() => {
+  // `Date` drives the due arithmetic; the timers own the wake schedule.
+  // Microtasks stay real so Cordis service publication keeps flowing.
+  vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout', 'Date'] })
+})
+afterEach(() => { vi.useRealTimers() })
+
+describe('automation domain', () => {
+  it('resolves the first due time for every schedule kind', () => {
+    expect(resolveDueAt({ kind: 'after', delaySeconds: 60 }, 1_000)).toBe(new Date(61_000).toISOString())
+    expect(resolveDueAt({ kind: 'at', at: '2026-01-01T00:00:00.000Z' }, 1_000)).toBe('2026-01-01T00:00:00.000Z')
+    expect(resolveDueAt({ kind: 'every', intervalSeconds: 60 }, 1_000)).toBe(new Date(61_000).toISOString())
+  })
+
+  it('coalesces missed recurring occurrences into the next anchor multiple', () => {
+    const anchor = '2026-01-01T00:00:00.000Z'
+    expect(nextRecurringAt(anchor, 60, Date.parse(anchor) + 30_000)).toBe('2026-01-01T00:01:00.000Z')
+    expect(nextRecurringAt(anchor, 60, Date.parse(anchor) + 61_000)).toBe('2026-01-01T00:02:00.000Z')
+    expect(nextRecurringAt(anchor, 60, Date.parse(anchor) + 3_000_000)).toBe('2026-01-01T00:51:00.000Z')
+  })
+
+  it('skips a failed one-shot but keeps a failed recurring automation due', () => {
+    const base: AutomationRecord = {
+      id: 'a' as AutomationRecord['id'],
+      title: 't', prompt: 'p',
+      schedule: { kind: 'after', delaySeconds: 60 },
+      cwd: '/w',
+      createdAt: 0, scheduledAt: new Date(0).toISOString(),
+      fireCount: 0,
+    }
+    expect(isDue(base, 1)).toBe(true)
+    expect(isDue({ ...base, lastError: 'boom' }, 1)).toBe(false)
+    const recurring = { ...base, schedule: { kind: 'every', intervalSeconds: 60 } as const }
+    expect(isDue({ ...recurring, lastError: 'boom', scheduledAt: new Date(0).toISOString() }, 1)).toBe(true)
+    expect(isDue({ ...recurring, maxRuns: 2, fireCount: 2 }, 1)).toBe(false)
+  })
+
+  it('validates creation input against the deployment limits', () => {
+    expect(() => validateAutomationInput({ title: '', prompt: 'p', schedule: { kind: 'after', delaySeconds: 60 }, maxRuns: undefined }, LIMITS))
+      .toThrow('title must be a non-empty string')
+    expect(() => validateAutomationInput({ title: 't', prompt: 'x'.repeat(2000), schedule: { kind: 'after', delaySeconds: 60 }, maxRuns: undefined }, LIMITS))
+      .toThrow('prompt exceeds')
+    expect(() => validateAutomationInput({ title: 't', prompt: 'p', schedule: { kind: 'after', delaySeconds: 1 }, maxRuns: undefined }, LIMITS))
+      .toThrow('at least 60')
+    expect(() => validateAutomationInput({ title: 't', prompt: 'p', schedule: { kind: 'at', at: 'not-a-date' }, maxRuns: undefined }, LIMITS))
+      .toThrow('ISO-8601')
+    expect(() => validateAutomationInput({ title: 't', prompt: 'p', schedule: { kind: 'every', intervalSeconds: 60 }, maxRuns: 3 }, LIMITS))
+      .not.toThrow()
+    expect(() => validateAutomationInput({ title: 't', prompt: 'p', schedule: { kind: 'after', delaySeconds: 60 }, maxRuns: 3 }, LIMITS))
+      .toThrow('applies only to recurring')
+    expect(() => validateAutomationInput({ title: 't', prompt: 'p', schedule: { kind: 'wat' }, maxRuns: undefined }, LIMITS))
+      .toThrow('schedule.kind')
+  })
+
+  it('frames the fired prompt as scheduled work', () => {
+    const record = { title: 'Sweep logs', scheduledAt: new Date(0).toISOString() } as AutomationRecord
+    expect(renderAutomationFraming(record, 2)).toContain('"Sweep logs"')
+    expect(renderAutomationFraming(record, 2)).toContain('occurrence 2')
+  })
+})
+
+/** Stub `agents` registry: records creations and answers with one canned handle. */
+class StubAgents extends Service {
+  static inject = []
+  readonly createCalls: Array<Record<string, unknown>> = []
+  createFailure: Error | undefined
+  readonly followups: UserMessage[] = []
+  private readonly handle: AgentHandle
+
+  constructor(ctx: Context) {
+    super(ctx, 'agents')
+    const agent = {
+      session: Session.create(SessionId('spawned')),
+      followup: (message: UserMessage) => { this.followups.push(message) },
+    } as unknown as Agent
+    this.handle = { agent, dispose: async () => {} }
+  }
+
+  create(options: Record<string, unknown>): Promise<AgentHandle> {
+    this.createCalls.push(options)
+    const setup = options.setup
+    const promise = typeof setup === 'function'
+      ? Promise.resolve(setup({} as Context)).then(() => this.handle)
+      : Promise.resolve(this.handle)
+    if (this.createFailure !== undefined) return Promise.reject(this.createFailure)
+    return promise
+  }
+}
+
+/** Stub `agentPresets`: resolves any recorded id and reports one mounted preset. */
+class StubPresets extends Service {
+  static inject = []
+  readonly mountedIds: string[] = []
+  resolveFailure: Error | undefined
+
+  constructor(ctx: Context) {
+    super(ctx, 'agentPresets')
+  }
+
+  async resolve(): Promise<{ id: string }> {
+    if (this.resolveFailure !== undefined) throw this.resolveFailure
+    return { id: 'standard' }
+  }
+
+  async standingKeyFor(): Promise<void> {}
+
+  composedPreset(): string | undefined {
+    return undefined
+  }
+
+  async mount(_agentCtx: Context, id: string): Promise<void> {
+    this.mountedIds.push(id)
+  }
+}
+
+describe('the automations service and tools', () => {
+  interface Harness { ctx: Context; root: string; agents: StubAgents; presets: StubPresets; dispose(): Promise<void> }
+
+  const harnesses: Harness[] = []
+
+  async function harness(): Promise<Harness> {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-automations-test-'))
+    const ctx = new Context()
+    try {
+      await ctx.plugin(Storage)
+      await ctx.plugin(StorageJson, { root })
+      await ctx.plugin(StorageDomain, { backend: 'json' })
+      await ctx.plugin(SystemPrompt)
+      await ctx.plugin(ToolRuntime)
+      await ctx.plugin(StubAgents)
+      await ctx.plugin(StubPresets)
+      await ctx.plugin(AutomationsService, LIMITS)
+      const h: Harness = {
+        ctx,
+        root,
+        agents: ctx.get('agents') as unknown as StubAgents,
+        presets: ctx.get('agentPresets') as unknown as StubPresets,
+        async dispose() {
+          await ctx.fiber.dispose()
+          await rm(root, { recursive: true, force: true })
+        },
+      }
+      harnesses.push(h)
+      return h
+    } catch (error: unknown) {
+      await ctx.fiber.dispose()
+      await rm(root, { recursive: true, force: true })
+      throw error
+    }
+  }
+
+  afterEach(async () => {
+    await Promise.all(harnesses.splice(0).map(value => value.dispose()))
+  })
+
+  let callCounter = 0
+  const CALL_IDS = [
+    ToolCallId('c1'), ToolCallId('c2'), ToolCallId('c3'),
+    ToolCallId('c4'), ToolCallId('c5'), ToolCallId('c6'),
+    ToolCallId('c7'), ToolCallId('c8'),
+  ]
+
+  /**
+   * Poll until a condition holds: each attempt advances fake time a step
+   * (driving any lagging re-arm timer) and then lets real event-loop ticks
+   * run, so the fire chain's durable writes settle.
+   */
+  async function until(fn: () => Promise<boolean>, what: string): Promise<void> {
+    for (let attempts = 0; attempts < 200; attempts++) {
+      if (await fn()) return
+      await vi.advanceTimersByTimeAsync(250)
+      await new Promise(resolve => setImmediate(resolve))
+    }
+    throw new Error(`condition not reached: ${what}`)
+  }
+
+  function executeCall(ctx: Context, name: string, args: Record<string, unknown>, agent?: Agent) {
+    const callId = CALL_IDS[callCounter % CALL_IDS.length]!
+    callCounter += 1
+    return ctx.tools.execute({
+      callId,
+      name,
+      arguments: args,
+      signal: new AbortController().signal,
+      ...agent ? { agent } : {},
+    })
+  }
+
+  function stubAgent(cwd = '/tmp/automation-workspace'): Agent {
+    const session = Session.create(SessionId('agent-1'), undefined, {
+      version: SESSION_FORMAT_VERSION, id: SessionId('agent-1'), createdAt: 0, cwd,
+    })
+    return { session } as unknown as Agent
+  }
+
+  function resultText(result: { content: readonly { type: string; text?: string }[] }): string {
+    return result.content.map(block => block.text ?? '').join('\n')
+  }
+
+  it('registers the three automation tools', async () => {
+    const value = await harness()
+    const names = value.ctx.tools.schemas().map(tool => tool.name)
+    expect(names).toEqual(expect.arrayContaining(['automation_create', 'automation_list', 'automation_cancel']))
+  })
+
+  it('creates, lists, and cancels an automation through the tools', async () => {
+    const value = await harness()
+    const agent = stubAgent()
+
+    const created = await executeCall(value.ctx, 'automation_create', {
+      title: 'Sweep logs', prompt: 'sweep the logs', kind: 'after', delay_seconds: 120,
+    }, agent)
+    expect(created.isError).toBe(false)
+
+    const listed = await executeCall(value.ctx, 'automation_list', {}, agent)
+    const text = resultText(listed)
+    expect(text).toContain('"Sweep logs"')
+    expect(text).toMatch(/[0-9a-f-]{36}/)
+
+    const cancelled = await executeCall(value.ctx, 'automation_cancel', { id: /[0-9a-f-]{36}/.exec(text)![0] }, agent)
+    expect(cancelled.isError).toBe(false)
+    const empty = await executeCall(value.ctx, 'automation_list', {}, agent)
+    expect(resultText(empty)).toContain('no scheduled automations')
+
+    const unknown = await executeCall(value.ctx, 'automation_cancel', { id: 'ffffffff-ffff-ffff-ffff-ffffffffffff' }, agent)
+    expect(unknown.isError).toBe(true)
+    expect(resultText(unknown)).toContain('no automation with id')
+  })
+
+  it('anchors the recorded preset and rejects bad input and agentless calls', async () => {
+    const value = await harness()
+    const agent = stubAgent()
+
+    const agentless = await executeCall(value.ctx, 'automation_create', {
+      title: 't', prompt: 'p', kind: 'after', delay_seconds: 60,
+    })
+    expect(agentless.isError).toBe(true)
+    expect(resultText(agentless)).toContain('requires a calling agent')
+
+    const bad = await executeCall(value.ctx, 'automation_create', {
+      title: 't', prompt: 'p', kind: 'after', delay_seconds: 1,
+    }, agent)
+    expect(bad.isError).toBe(true)
+    expect(resultText(bad)).toContain('at least 60')
+
+    const ok = await executeCall(value.ctx, 'automation_create', {
+      title: 't', prompt: 'p', kind: 'after', delay_seconds: 60,
+    }, agent)
+    expect(ok.isError).toBe(false)
+  })
+
+  it('fires a due one-shot into a fresh session and removes the record', async () => {
+    const value = await harness()
+    const agent = stubAgent()
+
+    const created = await executeCall(value.ctx, 'automation_create', {
+      title: 'Nightly sweep', prompt: 'sweep everything', kind: 'after', delay_seconds: 60,
+    }, agent)
+    expect(created.isError).toBe(false)
+
+    await vi.advanceTimersByTimeAsync(61_000)
+    expect(value.agents.createCalls).toHaveLength(1)
+    const options = value.agents.createCalls[0]!
+    expect((options.meta as { cwd?: string }).cwd).toBe('/tmp/automation-workspace')
+    expect((options.meta as { agentPreset?: string }).agentPreset).toBe('standard')
+    expect(value.presets.mountedIds).toEqual(['standard'])
+    expect(value.agents.followups).toHaveLength(1)
+    const message = value.agents.followups[0]!
+    const text = message.content.map(block => block.type === 'text' ? block.text : '').join('')
+    expect(text).toContain('"Nightly sweep"')
+    expect(text).toContain('sweep everything')
+
+    await until(async () => resultText(await executeCall(value.ctx, 'automation_list', {}, agent))
+      .includes('no scheduled automations'), 'one-shot record consumed after fire')
+
+    const listed = await executeCall(value.ctx, 'automation_list', {}, agent)
+    expect(resultText(listed)).toContain('no scheduled automations')
+  })
+
+  it('keeps a recurring automation alive with a coalesced next fire, honoring maxRuns', async () => {
+    const value = await harness()
+    const agent = stubAgent()
+
+    await executeCall(value.ctx, 'automation_create', {
+      title: 'Tick', prompt: 'do the tick', kind: 'every', interval_seconds: 60, max_runs: 2,
+    }, agent)
+
+    await vi.advanceTimersByTimeAsync(61_000)
+    await until(() => Promise.resolve(value.agents.createCalls.length === 1), 'first recurring fire')
+
+    await vi.advanceTimersByTimeAsync(60_000)
+    await until(() => Promise.resolve(value.agents.createCalls.length === 2), 'second recurring fire')
+
+    await vi.advanceTimersByTimeAsync(120_000)
+    await until(() => Promise.resolve(value.agents.createCalls.length === 2), 'maxRuns ceiling holds')
+    await until(async () => resultText(await executeCall(value.ctx, 'automation_list', {}, agent))
+      .includes('no scheduled automations'), 'exhausted record consumed')
+  })
+
+  it('records the failure of a one-shot and never re-fires it', async () => {
+    const value = await harness()
+    value.agents.createFailure = new Error('no route')
+    const agent = stubAgent()
+
+    await executeCall(value.ctx, 'automation_create', {
+      title: 'Doomed', prompt: 'this will fail', kind: 'after', delay_seconds: 60,
+    }, agent)
+
+    await vi.advanceTimersByTimeAsync(61_000)
+    await until(() => Promise.resolve(value.agents.createCalls.length === 1), 'doomed fire attempted')
+    await until(async () => resultText(await executeCall(value.ctx, 'automation_list', {}, agent))
+      .includes('no route'), 'failed fire recorded on the list')
+
+    expect(value.agents.createCalls).toHaveLength(1)
+
+    await vi.advanceTimersByTimeAsync(600_000)
+    await until(() => Promise.resolve(value.agents.createCalls.length === 1), 'failed one-shot never re-fires')
+
+    const listed = await executeCall(value.ctx, 'automation_list', {}, agent)
+    const text = resultText(listed)
+    expect(text).toContain('"Doomed"')
+    expect(text).toContain('no route')
+  })
+
+  it('spawns the session through the recorded preset with a framed prompt', async () => {
+    const ctx = new Context()
+    const createCalls: Array<Record<string, unknown>> = []
+    const followups: UserMessage[] = []
+    const fakeCtx = {
+      get: (key: string) => {
+        if (key === 'agents') {
+          return {
+            create: async (options: Record<string, unknown>) => {
+              createCalls.push(options)
+              return {
+                agent: {
+                  session: Session.create(SessionId('spawned')),
+                  followup: (message: UserMessage) => { followups.push(message) },
+                },
+                dispose: async () => {},
+              }
+            },
+          }
+        }
+        if (key === 'agentPresets') {
+          return {
+            resolve: async () => ({ id: 'standard' }),
+            standingKeyFor: async () => {},
+            mount: async (_agentCtx: Context, id: string) => { void id },
+          }
+        }
+        return undefined
+      },
+    } as unknown as Context
+    const record: AutomationRecord = {
+      id: 'a' as AutomationRecord['id'],
+      title: 'Manual', prompt: 'do it',
+      schedule: { kind: 'after', delaySeconds: 60 },
+      cwd: '/tmp/w', agentPreset: 'standard',
+      createdAt: 0, scheduledAt: new Date(0).toISOString(),
+      fireCount: 0,
+    }
+    await spawnAutomationSession(fakeCtx, record, 1, new AbortController().signal)
+    expect(createCalls).toHaveLength(1)
+    expect(followups).toHaveLength(1)
+    void ctx
+  })
+})
