+/** Client-safe payloads and durable record shapes for cross-session automations. */
+import type { Branded } from '@deepseek-ai/dsh-brand'
+
+/** Opaque durable identifier of one automation. */
+export type AutomationId = Branded<'AutomationId'>
+
+/**
+ * When an automation fires. `after` and `at` are one-shot; `every` is
+ * fixed-rate recurring, re-armed from the due time so missed occurrences
+ * while the process was down coalesce into one catch-up fire.
+ */
+export type AutomationSchedule =
+  | { readonly kind: 'after'; readonly delaySeconds: number }
+  | { readonly kind: 'at'; readonly at: string }
+  | { readonly kind: 'every'; readonly intervalSeconds: number }
+
+/** One durable automation: a stored prompt replayed into a fresh session on schedule. */
+export interface AutomationRecord {
+  readonly id: AutomationId
+  /** Short human-facing label shown in list output and the spawned session title. */
+  readonly title: string
+  /** The exact user prompt the spawned session receives. */
+  readonly prompt: string
+  readonly schedule: AutomationSchedule
+  /** Absolute workspace path recorded from the creating agent and reused at fire time. */
+  readonly cwd: string
+  /** Preset the spawned session mounts; absent composes the roster default. */
+  readonly agentPreset?: string
+  /** Epoch milliseconds at creation. */
+  readonly createdAt: number
+  /** ISO timestamp of the next (or, for a failed one-shot, the missed) fire. */
+  readonly scheduledAt: string
+  /** ISO timestamp of the last completed fire attempt; absent before the first fire. */
+  readonly lastFiredAt?: string
+  /** Completed fire attempts, successful or not. */
+  readonly fireCount: number
+  /** Fire ceiling for recurring automations; absent when unbounded. */
+  readonly maxRuns?: number
+  /** Last fire failure, kept for inspection; a failed one-shot never re-fires. */
+  readonly lastError?: string
+}
+
+/** The model-facing list row of one automation. */
+export interface AutomationView {
+  readonly id: AutomationId
+  readonly title: string
+  readonly schedule: AutomationSchedule
+  readonly nextRunAt: string
+  readonly fireCount: number
+  readonly maxRuns?: number
+  readonly lastFiredAt?: string
+  readonly lastError?: string
+}
+
+/** The create tool's result. */
+export interface AutomationCreateResult {
+  readonly id: AutomationId
+  readonly nextRunAt: string
+}
