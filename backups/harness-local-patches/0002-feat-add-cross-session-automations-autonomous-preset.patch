+++ b/packages/schedule/automations/src/index.ts
@@ -0,0 +1,462 @@
+/**
+ * Cross-session automations (`ctx.automations`): durable stored prompts that
+ * spawn a FRESH session when due — the scheduling counterpart of
+ * `dsh-schedule`, whose reminders stay inside one conversation.
+ *
+ * The service is a host-plane singleton: automations must outlive the session
+ * that created them, so records persist in the `automations` storage domain
+ * (not any session log) and the due driver runs on one process-level timer.
+ * Firing composes a new root session over the recorded workspace and agent
+ * preset — the same creation path the webhook ingress uses — and delivers the
+ * stored prompt as an ordinary user message. The process must be alive at the
+ * due time: occurrences missed while down coalesce into one catch-up fire at
+ * the next boot or tick.
+ *
+ * The spawn-time services (`agents`, `agentPresets`, and the optional
+ * `workspaceRegistry` / `sessionTitle`) are resolved at FIRE time rather than
+ * injected: registration and the model-facing tools never need them, and a
+ * composition that cannot spawn sessions fails loud on the first due record
+ * instead of at load.
+ * @module @deepseek-ai/dsh-automations
+ */
+
+import { randomUUID } from 'node:crypto'
+import { Context, Service } from '@deepseek-ai/cordis'
+import s from '@deepseek-ai/schemastery'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { JsonValue } from '@deepseek-ai/dsh-session'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+// Type-only edges: `ctx.tools` is declaration-merged by dsh-tools; the spawn
+// path resolves `agents` and `agentPresets` through their merged Context faces.
+import type {} from '@deepseek-ai/dsh-tools'
+import type { Agent, AgentRegistry } from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-agent-presets'
+import type { KvTable } from '@deepseek-ai/dsh-storage-domain'
+import {
+  allocateAutomationId,
+  isDue,
+  isExhausted,
+  nextRecurringAt,
+  renderAutomationFraming,
+  resolveDueAt,
+  validateAutomationInput,
+  viewOf,
+} from './domain.ts'
+import { automationsDomainSpec } from './spec.ts'
+import type { AutomationCreateResult, AutomationRecord, AutomationView } from './types.ts'
+
+/** Cordis plugin name. */
+export const name = 'automations'
+
+/** Services required to register the tools and persist records. */
+export const inject = ['tools', 'storageDomain']
+
+/** Largest delay a Node timer represents without clamping. */
+const MAX_TIMER_DELAY_MS = 2_147_483_647
+
+/** Deployment-varying limits of the create path. */
+export interface Config {
+  /** Byte ceiling on one stored prompt. */
+  maxPromptBytes: number
+  /** Lower bound for a one-shot `after` delay, in seconds. */
+  minDelaySeconds: number
+  /** Lower bound for a fixed-rate interval, in seconds. */
+  minIntervalSeconds: number
+}
+
+/** Runtime schema for {@link Config}; both bounds fail load when missing. */
+export const Config: s<Config> = s.object({
+  maxPromptBytes: s.number().step(1).min(1).required(),
+  minDelaySeconds: s.number().step(1).min(1).required(),
+  minIntervalSeconds: s.number().step(1).min(1).required(),
+})
+
+function resolveLimits(config: Partial<Config>): Config {
+  for (const key of ['maxPromptBytes', 'minDelaySeconds', 'minIntervalSeconds'] as const) {
+    const value = config[key]
+    if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 1) {
+      throw new Error(`automations: config.${key} must be a positive integer, got ${String(value)}`)
+    }
+  }
+  return {
+    maxPromptBytes: config.maxPromptBytes,
+    minDelaySeconds: config.minDelaySeconds,
+    minIntervalSeconds: config.minIntervalSeconds,
+  } as Config
+}
+
+/** Resolve one fire-time service, failing loud when the composition lacks it. */
+function requireAgents(ctx: Context): AgentRegistry {
+  const agents = ctx.get('agents')
+  if (agents === undefined) {
+    throw new Error('automations: the `agents` service is not composed; sessions cannot be spawned')
+  }
+  return agents
+}
+
+/**
+ * Compose one fresh root session for a fired automation and deliver its
+ * prompt — the webhook ingress creation path with the automation's recorded
+ * workspace and preset. The workspace registry and session title services are
+ * optional refinements: absent registry keeps the session file-backed by its
+ * cwd, absent titler keeps the default title.
+ * @param ctx - host context that owns the resulting agent.
+ * @param record - the automation being fired.
+ * @param occurrence - 1-based fire attempt count, for the framing text.
+ * @param signal - cancellation through publication.
+ */
+export async function spawnAutomationSession(
+  ctx: Context,
+  record: AutomationRecord,
+  occurrence: number,
+  signal: AbortSignal,
+): Promise<void> {
+  const agents = requireAgents(ctx)
+  const presets = ctx.get('agentPresets')
+  const workspaces = ctx.get('workspaceRegistry')
+  const titler = ctx.get('sessionTitle')
+  const preset = presets === undefined ? undefined : await presets.resolve(record.agentPreset)
+  if (presets !== undefined && preset !== undefined) await presets.standingKeyFor(preset.id)
+  signal.throwIfAborted()
+
+  const sessionId = SessionId(`automation-${randomUUID()}`)
+  const handle = await agents.create({
+    sessionId,
+    signal,
+    meta: {
+      cwd: record.cwd,
+      ...(preset !== undefined ? { agentPreset: preset.id } : {}),
+    },
+    ...(presets !== undefined && preset !== undefined
+      ? { setup: async (agentCtx: Context) => { await presets.mount(agentCtx, preset.id) } }
+      : {}),
+  })
+
+  let attached: { detachSession(sessionId: SessionId): Promise<void> } | undefined
+  try {
+    signal.throwIfAborted()
+    if (workspaces !== undefined) {
+      const workspace = await workspaces.create(record.cwd)
+      await workspace.attachSession(sessionId)
+      attached = workspace
+    }
+    if (titler !== undefined) titler.rename(handle.agent.session, record.title)
+    handle.agent.followup(createUserMessage({
+      content: [{
+        type: 'text',
+        text: `${renderAutomationFraming(record, occurrence)}\n\n${record.prompt}`,
+      }],
+      source: {
+        kind: 'plugin',
+        plugin: 'automations',
+        form: 'notice',
+        summary: `scheduled automation "${record.title}" fired`,
+      },
+    }))
+  } catch (error: unknown) {
+    if (attached !== undefined) {
+      try {
+        await attached.detachSession(sessionId)
+      } catch (rollbackError: unknown) {
+        ctx.logger?.warn('automations: workspace detach for session "%s" failed: %o', sessionId, rollbackError)
+      }
+    }
+    try {
+      await handle.dispose()
+    } catch (disposeError: unknown) {
+      ctx.logger?.warn('automations: failed to dispose session "%s" after a failed fire: %o', sessionId, disposeError)
+    }
+    throw error
+  }
+}
+
+/**
+ * The automations runtime: owns the durable table, the due driver, and the
+ * three model-facing tools. One instance per process, keyed by nothing —
+ * records are global by design.
+ */
+export class AutomationsService extends Service {
+  /** Services required to register the tools and persist records. */
+  static inject = ['tools', 'storageDomain']
+
+  /** Loader-validated deployment limits. */
+  static Config: s<Config> = Config
+
+  private readonly limits: Config
+  private table: KvTable<string, AutomationRecord> | undefined
+  private timer: ReturnType<typeof setTimeout> | undefined
+  private tail: Promise<void> = Promise.resolve()
+  private driving = false
+  private disposed = false
+
+  constructor(ctx: Context, config: Partial<Config>) {
+    super(ctx, 'automations')
+    this.limits = resolveLimits(config)
+  }
+
+  /** Open the domain, install the tools, and start the due driver. */
+  protected async [Service.init](): Promise<void> {
+    const domain = await this.ctx.storageDomain.open(automationsDomainSpec)
+    this.table = domain.table('automations')
+    const disposeTools = this.registerTools()
+    this.ctx.effect(() => async () => {
+      this.disposed = true
+      if (this.timer !== undefined) clearTimeout(this.timer)
+      await this.tail
+      disposeTools()
+      await domain.close()
+    }, 'automations.dispose')
+    this.requestDrive()
+  }
+
+  private requireTable(): KvTable<string, AutomationRecord> {
+    if (this.table === undefined) throw new Error('automations: service not initialized')
+    return this.table
+  }
+
+  /** Register the three model-facing tools on the host layer. */
+  private registerTools(): () => void {
+    const disposeCreate = this.ctx.tools.register(defineTool({
+      name: 'automation_create',
+      description: 'Schedule a recurring or one-shot automation: store a prompt that spawns a FRESH session in this workspace when due. The process must be running at the due time; missed occurrences coalesce into one catch-up fire.',
+      parameters: {
+        title: {
+          type: 'string',
+          required: true,
+          description: 'A short (3-5 word) label shown in list output and as the spawned session title.',
+        },
+        prompt: {
+          type: 'string',
+          required: true,
+          description: 'The complete, self-contained task the spawned session will receive as its user message. It starts with no context from this conversation.',
+        },
+        kind: {
+          type: 'string',
+          required: true,
+          description: '"after" fires once delay_seconds from now; "at" fires once at the ISO-8601 `at` timestamp; "every" fires on a fixed rate of interval_seconds. "after" and "at" are one-shot.',
+        },
+        delay_seconds: { type: 'number', description: 'Seconds from now until the one-shot fire (kind "after").' },
+        at: { type: 'string', description: 'ISO-8601 timestamp of the one-shot fire (kind "at").' },
+        interval_seconds: { type: 'number', description: 'Fixed-rate interval in seconds (kind "every").' },
+        max_runs: { type: 'number', description: 'Fire ceiling for recurring ("every") automations; omit for unbounded.' },
+      },
+      output: {
+        schema: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            id: { type: 'string', required: true },
+            nextRunAt: { type: 'string', required: true },
+          },
+        },
+        render: (_args, value) => [{
+          type: 'text',
+          text: `automation ${value.id} created; first fire scheduled at ${value.nextRunAt}`,
+        }],
+      },
+      isConcurrencySafe: () => true,
+      execute: async (args, exec) => this.create(args, exec.agent),
+    }))
+
+    const disposeList = this.ctx.tools.register(defineTool({
+      name: 'automation_list',
+      description: 'List the scheduled automations of this deployment with their next fire times.',
+      parameters: {},
+      output: {
+        schema: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            automations: { type: 'array', required: true, items: { type: 'json' } },
+          },
+        },
+        render: (_args, value) => [{
+          type: 'text',
+          text: value.automations.length === 0
+            ? 'no scheduled automations'
+            : value.automations
+              .map(entry => entry as unknown as AutomationView)
+              .map(view =>
+                `${view.id} "${view.title}" ${view.schedule.kind} next=${view.nextRunAt} fires=${String(view.fireCount)}`
+                + (view.lastError === undefined ? '' : ` lastError="${view.lastError}"`))
+              .join('\n'),
+        }],
+      },
+      isConcurrencySafe: () => true,
+      execute: async () => ({ automations: this.list() as unknown as JsonValue[] }),
+    }))
+
+    const disposeCancel = this.ctx.tools.register(defineTool({
+      name: 'automation_cancel',
+      description: 'Cancel one scheduled automation by id. Idempotent per id: cancelling an unknown id reports so.',
+      parameters: {
+        id: { type: 'string', required: true, description: 'The automation id from automation_create or automation_list.' },
+      },
+      output: {
+        schema: {
+          type: 'object',
+          additionalProperties: false,
+          properties: {
+            cancelled: { type: 'boolean', required: true, const: true },
+          },
+        },
+        render: () => [{ type: 'text', text: 'automation cancelled' }],
+      },
+      isConcurrencySafe: () => true,
+      execute: async (args: { id?: unknown }) => {
+        const cancelled = await this.cancel(String(args.id))
+        if (!cancelled) throw new Error(`no automation with id "${String(args.id)}"`)
+        return { cancelled: true as const }
+      },
+    }))
+
+    return () => { disposeCreate(); disposeList(); disposeCancel() }
+  }
+
+  /**
+   * Validate, persist, and schedule one automation from the create tool's
+   * flat arguments. The recording agent anchors the workspace (its session
+   * cwd) and the preset (its own composition), so the fire replays the same
+   * environment even across process restarts.
+   */
+  private async create(
+    args: Record<string, unknown>,
+    agent: Agent | undefined,
+  ): Promise<AutomationCreateResult> {
+    if (agent === undefined) {
+      throw new Error('automation_create requires a calling agent to anchor the workspace and preset')
+    }
+    const cwd = agent.session.header.cwd
+    if (cwd === undefined) throw new Error('automation_create requires the calling session to have a workspace cwd')
+    const presets = this.ctx.get('agentPresets')
+    const agentPreset = presets?.composedPreset(agent.ctx)
+    const kind = args.kind
+    const scheduleInput = {
+      kind,
+      ...(kind === 'after' ? { delaySeconds: args.delay_seconds } : {}),
+      ...(kind === 'at' ? { at: args.at } : {}),
+      ...(kind === 'every' ? { intervalSeconds: args.interval_seconds } : {}),
+    }
+    const validated = validateAutomationInput({
+      title: args.title,
+      prompt: args.prompt,
+      schedule: scheduleInput,
+      maxRuns: args.max_runs,
+    }, this.limits)
+    const id = allocateAutomationId()
+    const now = Date.now()
+    const record: AutomationRecord = {
+      id,
+      title: validated.title,
+      prompt: validated.prompt,
+      schedule: validated.schedule,
+      cwd,
+      ...(agentPreset === undefined ? {} : { agentPreset }),
+      createdAt: now,
+      scheduledAt: resolveDueAt(validated.schedule, now),
+      fireCount: 0,
+      ...(validated.maxRuns === undefined ? {} : { maxRuns: validated.maxRuns }),
+    }
+    await this.requireTable().put(record.id, record)
+    this.requestDrive()
+    return { id: record.id, nextRunAt: record.scheduledAt }
+  }
+
+  /** Every automation as a model-facing view, soonest fire first. */
+  private list(): AutomationView[] {
+    return [...this.requireTable().entries()]
+      .map(([, record]) => viewOf(record))
+      .sort((left, right) => Date.parse(left.nextRunAt) - Date.parse(right.nextRunAt))
+  }
+
+  /** Remove one automation durably; `false` when the id is unknown. */
+  private async cancel(id: string): Promise<boolean> {
+    return await this.requireTable().delete(id)
+  }
+
+  /** Request a due check; coalesces while a drive is already running. */
+  private requestDrive(): void {
+    if (this.disposed) return
+    queueMicrotask(() => { void this.drive() })
+  }
+
+  /** Fire everything due, then re-arm the wake timer on the next record. */
+  private async drive(): Promise<void> {
+    if (this.driving || this.disposed) return
+    this.driving = true
+    try {
+      const now = Date.now()
+      const due = [...this.requireTable().entries()]
+        .map(([, record]) => record)
+        .filter(record => isDue(record, now))
+      for (const record of due) {
+        const previous = this.tail
+        this.tail = (async () => {
+          await previous
+          await this.fire(record)
+        })()
+      }
+      await this.tail
+    } finally {
+      this.driving = false
+    }
+    this.rearm()
+  }
+
+  /** Fire one record and fold the outcome back into the durable table. */
+  private async fire(record: AutomationRecord): Promise<void> {
+    const now = Date.now()
+    const firedAt = new Date(now).toISOString()
+    const occurrence = record.fireCount + 1
+    let lastError: string | undefined
+    try {
+      await spawnAutomationSession(this.ctx, record, occurrence, new AbortController().signal)
+    } catch (error: unknown) {
+      lastError = error instanceof Error ? error.message : String(error)
+      this.ctx.logger?.error('automations: fire of "%s" failed: %s', record.title, lastError)
+    }
+    const table = this.requireTable()
+    const current = table.get(record.id)
+    if (current === undefined) return
+    if (record.schedule.kind === 'every') {
+      const scheduledAt = lastError === undefined
+        ? nextRecurringAt(record.scheduledAt, record.schedule.intervalSeconds, now)
+        : record.scheduledAt
+      const updated: AutomationRecord = {
+        ...record,
+        fireCount: occurrence,
+        lastFiredAt: firedAt,
+        scheduledAt,
+        ...(lastError === undefined ? {} : { lastError }),
+      }
+      if (lastError === undefined && isExhausted(updated)) await table.delete(record.id)
+      else await table.put(record.id, updated)
+      return
+    }
+    if (lastError === undefined) await table.delete(record.id)
+    else await table.put(record.id, { ...record, fireCount: occurrence, lastFiredAt: firedAt, lastError })
+  }
+
+  /** Schedule the next wake at the soonest actionable due time. */
+  private rearm(): void {
+    if (this.disposed) return
+    if (this.timer !== undefined) clearTimeout(this.timer)
+    const now = Date.now()
+    const next = [...this.requireTable().entries()]
+      .map(([, record]) => record)
+      .filter(record => isDue(record, Number.POSITIVE_INFINITY) || Date.parse(record.scheduledAt) > now)
+      .map(record => Date.parse(record.scheduledAt))
+      .reduce<number | undefined>((selected, candidate) => {
+        return candidate < (selected ?? Number.POSITIVE_INFINITY) ? candidate : selected
+      }, undefined)
+    if (next === undefined) return
+    const delay = Math.max(0, Math.min(next - now, MAX_TIMER_DELAY_MS))
+    this.timer = setTimeout(() => { void this.drive() }, delay)
+  }
+}
+
+export type { AutomationId, AutomationCreateResult, AutomationRecord, AutomationView } from './types.ts'
+export { AutomationInputError } from './domain.ts'
+export { automationsDomainSpec } from './spec.ts'
+export default AutomationsService
