@@ -0,0 +1,91 @@
+/**
+ * The model-facing plan-mode entry tool: the model can propose switching the
+ * session into plan mode for the task it is about to start.
+ *
+ * Plan state stays owned by `@deepseek-ai/dsh-plan-mode`: this plugin only
+ * forwards the model's intent to `ctx.planMode.set(agent, true)` and reports
+ * the outcome. A selection made from a tool call is always in-turn, so it
+ * applies at the next accepted pre-step; the same `/plan off` command that
+ * serves a user switch cancels a pending selection. Leaving plan mode stays
+ * gated by `exit_plan_mode`'s user review, so entry is the only
+ * model-initiated transition, and it only ever restricts the agent.
+ *
+ * @module @deepseek-ai/dsh-tool-plan-mode
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+// Type-only edge: declaration-merges `ctx.planMode` onto Context; the runtime
+// resolution goes through the `inject` list below.
+import type {} from '@deepseek-ai/dsh-plan-mode'
+
+/** Cordis plugin name. */
+export const name = 'tool-plan-mode'
+
+/** Services this plugin requires: the tool registry and the plan-mode controller. */
+export const inject = ['tools', 'planMode']
+
+/** The model-facing entry tool's name. */
+export const ENTER_PLAN_MODE = 'enter_plan_mode'
+
+const ENTER_DESCRIPTION
+  = 'Propose switching this session into plan mode. Use it before starting '
+  + 'non-trivial implementation work when the user should approve the approach '
+  + 'first. In plan mode you research and plan; implementation waits until your '
+  + 'exit_plan_mode call is approved. The switch applies from your next step; '
+  + 'the user can cancel it or leave plan mode at any time with /plan off.'
+
+/**
+ * Register the entry tool for the mounting context's scope.
+ * @param ctx - a context carrying `tools` and the `planMode` controller
+ *   (`@deepseek-ai/dsh-plan-mode` mounted in the same scope; the inject
+ *   resolution fails loud when it is absent).
+ */
+export function apply(ctx: Context): void {
+  const planMode = ctx.planMode
+  ctx.tools.register(defineTool({
+    name: ENTER_PLAN_MODE,
+    description: ENTER_DESCRIPTION,
+    parameters: {},
+    output: {
+      schema: {
+        type: 'object',
+        additionalProperties: false,
+        properties: {
+          entered: { type: 'boolean', required: true, const: true },
+          queued: { type: 'boolean', required: true },
+        },
+      },
+      render: (_args, value) => [{
+        type: 'text',
+        text: value.queued
+          ? 'Entering plan mode from your next step. Ground the plan in inspection first, then present it with exit_plan_mode.'
+          : 'Plan mode on. Ground the plan in inspection first, then present it with exit_plan_mode.',
+      }],
+    },
+    execute(_args, exec) {
+      const agent = exec.agent
+      if (agent === undefined) {
+        throw new Error(`${ENTER_PLAN_MODE} requires a calling agent (no session to switch)`)
+      }
+      if (planMode.get(agent).active) {
+        throw new Error(
+          `${ENTER_PLAN_MODE} is only available outside plan mode; `
+          + 'present your plan with exit_plan_mode instead',
+        )
+      }
+      const outcome = planMode.set(agent, true)
+      // `queued` is the normal in-turn path: the selection lands at the next
+      // accepted pre-step. `noop` with an inactive log means an identical
+      // entry selection is already queued. `cancelled` clears an opposite
+      // pending selection — the log already reads active, so nothing waits.
+      return Promise.resolve({ entered: true as const, queued: outcome === 'queued' || outcome === 'noop' })
+    },
+    presentCall: () => ({
+      card: 'generic',
+      title: 'Plan mode',
+      kind: 'other',
+      content: [{ type: 'text', text: 'The agent proposes switching this session into plan mode.' }],
+    }),
+  }))
+}
