+/** Package-owned invariant companion for `@deepseek-ai/dsh-automations`. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-automations'
+
+/** Cordis companion plugin name. */
+export const name = 'automations-invariant'
+/** Invariant registry dependency. */
+export const inject = ['invariants']
+
+/**
+ * No runtime invariant: the durable record shape is validated by the
+ * storage-domain schema at open, and the spawn-time relationships (session
+ * creation, preset mounting, workspace attachment) are owned and asserted by
+ * their own packages. This package only schedules and forwards.
+ */
+const install: InvariantInstaller = () => {}
+
+/** Register this package's invariant ownership. */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
diff --git a/packages/schedule/automations/src/spec.ts b/packages/schedule/automations/src/spec.ts
