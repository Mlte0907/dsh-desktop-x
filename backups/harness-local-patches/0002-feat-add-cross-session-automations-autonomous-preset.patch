+/**
+ * DSH Compatibility Shim - Client Plugin
+ *
+ * Adds backward-compatible module aliases to the browser module table:
+ * - `@deepseek-ai/dsh-client-runtime/client` → `@deepseek-ai/dsh-client-store`
+ *
+ * This allows old plugins that reference the removed dsh-client-runtime package
+ * to work with the current version.
+ */
+
+export const name = 'dsh-compat-shim-client'
+
+export const inject = ['modules']
+
+export function apply(_ctx) {
+  // The module alias is handled at boot time in seed.ts
+  // This client plugin just ensures the compat shim is loaded
+  console.log('[dsh-compat-shim-client] client compatibility layer loaded')
+}
diff --git a/packages/compat/dsh-compat-shim/src/index.ts b/packages/compat/dsh-compat-shim/src/index.ts
new file mode 100644
index 0000000000..82cc1e3542
--- /dev/null
+++ b/packages/compat/dsh-compat-shim/src/index.ts
@@ -0,0 +1,175 @@
+/**
+ * DSH Compatibility Shim Plugin
+ *
+ * Provides backward-compatible services for old plugins that reference
+ * removed or renamed services:
+ *
+ * - `apiProxy`: Old RPC-style API proxy (replaced by api-gateway Remote services)
+ * - `conversationEvents`: Old conversation events service (now uiConversation.events)
+ *
+ * Host-side plugin: runs in Node.js, provides services to other plugins.
+ */
+
+export const name = 'dsh-compat-shim'
+
+/** Wrap a result in the old RPC response format */
+function ok(request, value) {
+  return { rpcId: request.rpcId, result: { ok: true, value } }
+}
+
+/** Wrap an error in the old RPC response format */
+function makeError(request, code, message) {
+  return { rpcId: request.rpcId, result: { ok: false, error: { code, message } } }
+}
+
+/**
+ * Create an apiProxy-compatible interface using the new Remote services.
+ * This bridges old plugins to the new api-gateway architecture.
+ */
+function createApiProxy(ctx) {
+  return {
+    sessions: {
+      async list(request) {
+        try {
+          const result = await ctx.remote.session.list({})
+          if (result.ok) {
+            return ok(request, { items: result.value.items })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'list failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+
+      async create(request) {
+        try {
+          const payload = {}
+          if (request.payload.workspaceId) payload.workspaceId = request.payload.workspaceId
+          if (request.payload.agentPreset) payload.agentPreset = request.payload.agentPreset
+          const result = await ctx.remote.session.create(payload)
+          if (result.ok) {
+            return ok(request, { sessionId: result.value.sessionId })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'create failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+
+      async rename(request) {
+        try {
+          const result = await ctx.remote.session.rename({
+            sessionId: request.payload.sessionId,
+            title: request.payload.title,
+          })
+          if (result.ok) {
+            return ok(request, { sessionId: request.payload.sessionId })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'rename failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+
+      async prompt(request) {
+        try {
+          const result = await ctx.remote.session.prompt({
+            sessionId: request.payload.sessionId,
+            mode: request.payload.mode,
+            content: request.payload.content,
+          })
+          if (result.ok) {
+            return ok(request, undefined)
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'prompt failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+
+      async history(request) {
+        try {
+          const result = await ctx.remote.session.history({
+            sessionId: request.payload.sessionId,
+            fromSeq: request.payload.fromSeq,
+            limit: request.payload.limit,
+          })
+          if (result.ok) {
+            return ok(request, { entries: result.value.entries ?? [] })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'history failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+    },
+
+    workspace: {
+      async list(request) {
+        try {
+          const result = await ctx.remote.workspace.list({})
+          if (result.ok) {
+            return ok(request, { items: result.value.items })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'list failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+    },
+
+    agentPresets: {
+      async list(request) {
+        try {
+          const result = await ctx.remote.agentPresets.list({})
+          if (result.ok) {
+            return ok(request, { presets: result.value.presets })
+          }
+          return makeError(request, result.error?.code ?? 'UNKNOWN', result.error?.message ?? 'list failed')
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+    },
+
+    host: {
+      async describe(request) {
+        try {
+          const selection = ctx.get('agentDefaultModel')?.selection ?? { provider: 'unknown', model: 'unknown' }
+          return ok(request, {
+            version: '0.1.2-alpha.1',
+            cwd: process.cwd(),
+            provider: selection.provider,
+            model: selection.model,
+            attachedSessions: ctx.agents?.list().length ?? 0,
+            home: process.env.HOME ?? '~',
+            canOpenPath: false,
+          })
+        } catch (e) {
+          return makeError(request, 'INTERNAL', e.message)
+        }
+      },
+    },
+
+    downloads: {
+      sessionLog(_sessionId, _compressionLevel) {
+        // Stub: session log download not implemented in compat shim
+        throw new Error('sessionLog download not supported in compat shim')
+      },
+    },
+  }
+}
+
+export function apply(ctx) {
+  // Provide the apiProxy service for old plugins
+  ctx.effect(() => {
+    // @ts-ignore - providing legacy service
+    ctx.apiProxy = createApiProxy(ctx)
+    console.log('[dsh-compat-shim] apiProxy service registered')
+
+    return () => {
+      // @ts-ignore
+      ctx.apiProxy = undefined
+    }
+  }, 'dsh-compat-shim: apiProxy service')
+}
