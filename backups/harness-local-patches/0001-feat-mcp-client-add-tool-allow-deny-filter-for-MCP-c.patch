diff --git a/packages/mcp/mcp-client/src/tools.ts b/packages/mcp/mcp-client/src/tools.ts
index a580fd0c84..c414067cc4 100644
--- a/packages/mcp/mcp-client/src/tools.ts
+++ b/packages/mcp/mcp-client/src/tools.ts
@@ -26,12 +26,28 @@ import { assertSupportedJsonSchema } from '@deepseek-ai/dsh-tools'
 import type { JsonSchemaNode } from '@deepseek-ai/dsh-tools'
 import type { JsonValue } from '@deepseek-ai/dsh-util-values'
 
+/**
+ * Filter selecting which discovered tools register on the harness.
+ * Lists hold raw MCP tool names (as `tools/list` reports them), never the
+ * public `mcp__<serverName>__` names. `allow` restricts registration to its
+ * members; `deny` excludes its members; when both are present, a tool
+ * registers only if it is allowed and not denied.
+ */
+export interface ToolFilter {
+  /** Whitelist: only register these raw tool names; omission or empty registers all. */
+  allow?: string[]
+  /** Blacklist: never register these raw tool names. */
+  deny?: string[]
+}
+
 /** Resolved options relevant to tool bridging. */
 export interface ToolBridgeOptions {
   /** Whether a registry conflict is contained or rejects this synchronization. */
   registrationFailure: 'contain' | 'throw'
   serverName: string
   toolCallTimeoutMs: number
+  /** Selection of discovered tools to register; omission registers all. */
+  tools?: ToolFilter
 }
 
 /** State for one sync generation: the current set of disposers keyed by public name. */
@@ -148,11 +164,17 @@ export async function syncTools(
   previous: ToolDisposers,
 ): Promise<ToolDisposers> {
   // Phase 1: fetch and build the next generation without touching the registry.
+  const allow = opts.tools?.allow?.length ? new Set(opts.tools.allow) : undefined
+  const deny = opts.tools?.deny?.length ? new Set(opts.tools.deny) : undefined
+  const matched = allow ? new Set<string>() : undefined
   const definitions = new Map<string, ToolDefinition>()
   let cursor: string | undefined
   do {
     const response = await listToolsUncached(client, cursor)
     for (const tool of response.tools) {
+      if (allow && !allow.has(tool.name)) continue
+      if (deny?.has(tool.name)) continue
+      matched?.add(tool.name)
       const publicName = publicToolName(opts.serverName, tool.name)
       if (definitions.has(publicName)) {
         throw new Error(
@@ -173,6 +195,12 @@ export async function syncTools(
     }
     cursor = response.nextCursor
   } while (cursor)
+  if (allow && matched && matched.size < allow.size) {
+    const missing = [...allow].filter(name => !matched.has(name))
+    ctx.logger.warn(
+      `mcp-client(${opts.serverName}): tools.allow names not offered by the server: ${missing.join(', ')}`,
+    )
+  }
 
   // Phase 2: swap generations.
   for (const dispose of previous.values()) dispose()
diff --git a/packages/mcp/mcp-client/tests/apply.spec.ts b/packages/mcp/mcp-client/tests/apply.spec.ts
index 1b1716e51b..87e4a4b0bb 100644
--- a/packages/mcp/mcp-client/tests/apply.spec.ts
+++ b/packages/mcp/mcp-client/tests/apply.spec.ts
@@ -412,3 +412,74 @@ describe('apply (plugin lifecycle)', () => {
     expect(ctx.tools.get('mcp__web__remote')).toBeDefined()
   })
 })
+
+describe('apply (tool filter)', () => {
+  let ctx: Context
+
+  beforeEach(async () => {
+    vi.clearAllMocks()
+    mockConnect.mockResolvedValue(undefined)
+    mockClose.mockImplementation(function (this: { onclose?: () => void }) {
+      this.onclose?.()
+      return Promise.resolve()
+    })
+    mockListTools.mockResolvedValue({
+      tools: [
+        { name: 'keep', description: 'keep me', inputSchema: { type: 'object' } },
+        { name: 'drop', description: 'drop me', inputSchema: { type: 'object' } },
+      ],
+      nextCursor: undefined,
+    })
+    mockCallTool.mockResolvedValue({ content: [{ type: 'text', text: 'ok' }] })
+    ctx = await mountRegistry()
+  })
+
+  it('Config schema materializes the tools filter', () => {
+    const resolved = ConfigSchema({
+      transport: 'stdio',
+      serverName: 'srv',
+      command: 'echo',
+      tools: { allow: ['keep'] },
+    } as never)
+    expect(resolved.tools).toEqual({ allow: ['keep'], deny: [] })
+  })
+
+  it('registers only tools on the allow list', async () => {
+    await apply(ctx, { ...stdioConfig, tools: { allow: ['keep'] } })
+
+    expect(ctx.tools.get('mcp__srv__keep')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__drop')).toBeUndefined()
+  })
+
+  it('excludes tools on the deny list', async () => {
+    await apply(ctx, { ...stdioConfig, tools: { deny: ['drop'] } })
+
+    expect(ctx.tools.get('mcp__srv__keep')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__drop')).toBeUndefined()
+  })
+
+  it('prefers deny over allow for a tool matching both lists', async () => {
+    await apply(ctx, { ...stdioConfig, tools: { allow: ['keep', 'drop'], deny: ['drop'] } })
+
+    expect(ctx.tools.get('mcp__srv__keep')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__drop')).toBeUndefined()
+  })
+
+  it('registers every tool when no filter is configured', async () => {
+    await apply(ctx, stdioConfig)
+
+    expect(ctx.tools.get('mcp__srv__keep')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__drop')).toBeDefined()
+  })
+
+  it('warns when an allow-listed name is not offered by the server', async () => {
+    const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => {})
+    await apply(ctx, { ...stdioConfig, tools: { allow: ['keep', 'ghost'] } })
+
+    expect(ctx.tools.get('mcp__srv__keep')).toBeDefined()
+    expect(ctx.tools.get('mcp__srv__ghost')).toBeUndefined()
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining('tools.allow names not offered by the server: ghost'),
+    )
+  })
+})
